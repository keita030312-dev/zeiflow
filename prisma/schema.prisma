generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model SystemConfig {
  id    String @id @default("system")
  key   String @unique
  value String

  @@map("system_config")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  apiKey    String?  @map("api_key")
  isActive   Boolean  @default(true) @map("is_active")
  // default は true。新規登録時は register API で明示的に false を入れる。
  // これで「既存組織のデフォルトロックアウト」を防ぐ。
  isApproved Boolean  @default(true) @map("is_approved")
  plan       String   @default("free") @map("plan")
  note       String?  @map("note")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members        User[]
  clients        Client[]
  receipts       Receipt[]
  journalEntries JournalEntry[]
  exportLogs     ExportLog[]
  auditLogs      AuditLog[]
  portalTokens   ClientPortalToken[]
  knowledgeFiles KnowledgeFile[]
  accountMasters AccountMaster[]

  @@map("organizations")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String    @map("password_hash")
  resetToken        String?   @map("reset_token")
  resetTokenExpiry  DateTime? @map("reset_token_expiry")
  totpSecret      String?   @map("totp_secret")
  totpEnabled     Boolean   @default(false) @map("totp_enabled")
  anthropicApiKey String?   @map("anthropic_api_key")
  role            Role      @default(STAFF)
  organizationId  String?   @map("organization_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  organization  Organization? @relation(fields: [organizationId], references: [id])
  clients       Client[]
  receipts      Receipt[]
  journalEntries JournalEntry[]
  exportLogs    ExportLog[]
  auditLogs     AuditLog[]
  portalTokens  ClientPortalToken[]
  knowledgeFiles KnowledgeFile[]
  accountMasters AccountMaster[]

  @@map("users")
}

enum Role {
  ADMIN
  STAFF
}

model Client {
  id              String    @id @default(cuid())
  code            String
  name            String
  nameKana        String?   @map("name_kana")
  clientType      ClientType @default(CORPORATE) @map("client_type")
  fiscalYearStart Int       @default(4) @map("fiscal_year_start")
  taxType          TaxType          @default(STANDARD) @map("tax_type")
  accountingMethod AccountingMethod @default(TAX_INCLUSIVE) @map("accounting_method")
  invoiceRegNumber String?  @map("invoice_reg_number")
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  userId          String    @map("user_id")
  organizationId  String?   @map("organization_id")

  user            User      @relation(fields: [userId], references: [id])
  organization    Organization? @relation(fields: [organizationId], references: [id])
  receipts        Receipt[]
  journalEntries  JournalEntry[]
  exportLogs      ExportLog[]
  portalTokens    ClientPortalToken[]
  knowledgeFiles  KnowledgeFile[]

  @@unique([code, userId], name: "client_code_user")
  @@unique([code, organizationId], name: "client_code_org")
  @@map("clients")
}

enum ClientType {
  CORPORATE
  INDIVIDUAL
}

enum TaxType {
  STANDARD
  SIMPLIFIED
  EXEMPT
}

enum AccountingMethod {
  TAX_INCLUSIVE
  TAX_EXCLUSIVE
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

/// アップロード書類の種類（OCRプロンプト切替）
enum DocumentKind {
  RECEIPT
  INVOICE
  OFFICIAL_RECEIPT
}

model Receipt {
  id          String        @id @default(cuid())
  imagePath   String        @map("image_path")
  imageData   String?       @map("image_data")
  imageMime   String?       @map("image_mime")
  ocrRaw      String?       @map("ocr_raw")
  documentKind DocumentKind @default(RECEIPT) @map("document_kind")
  status      ReceiptStatus @default(PENDING)
  uploadedAt  DateTime      @default(now()) @map("uploaded_at")
  clientId    String        @map("client_id")
  userId      String        @map("user_id")
  organizationId String?    @map("organization_id")

  client      Client        @relation(fields: [clientId], references: [id])
  user        User          @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  journalEntries JournalEntry[]

  @@map("receipts")
}

enum ReceiptStatus {
  PENDING
  PROCESSING
  COMPLETED
  ERROR
}

model JournalEntry {
  id              String    @id @default(cuid())
  date            DateTime
  debitAccount    String    @map("debit_account")
  debitSubAccount String?   @map("debit_sub_account")
  creditAccount   String    @map("credit_account")
  creditSubAccount String?  @map("credit_sub_account")
  amount          Int
  taxAmount       Int?      @map("tax_amount")
  taxRate         Float?    @map("tax_rate")
  taxCategory     String?   @map("tax_category") // 旧: 単一税区分(後方互換のため残置。新規保存では null 化)
  debitTaxCategory  String? @map("debit_tax_category")
  creditTaxCategory String? @map("credit_tax_category")
  description     String
  invoiceNumber   String?   @map("invoice_number")
  memo            String?
  isConfirmed     Boolean   @default(false) @map("is_confirmed")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  clientId        String    @map("client_id")
  userId          String    @map("user_id")
  receiptId       String?   @map("receipt_id")
  organizationId  String?   @map("organization_id")

  client          Client    @relation(fields: [clientId], references: [id])
  user            User      @relation(fields: [userId], references: [id])
  receipt         Receipt?  @relation(fields: [receiptId], references: [id])
  organization    Organization? @relation(fields: [organizationId], references: [id])

  @@map("journal_entries")
}

model ExportLog {
  id          String      @id @default(cuid())
  format      ExportFormat
  periodType  PeriodType  @map("period_type")
  periodStart DateTime    @map("period_start")
  periodEnd   DateTime    @map("period_end")
  recordCount Int         @map("record_count")
  exportedAt  DateTime    @default(now()) @map("exported_at")
  clientId    String      @map("client_id")
  userId      String      @map("user_id")
  organizationId String?  @map("organization_id")

  client      Client      @relation(fields: [clientId], references: [id])
  user        User        @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@map("export_logs")
}

enum ExportFormat {
  YAYOI
  MONEYFORWARD
  FREEE
}

enum PeriodType {
  MONTHLY
  SEMI_ANNUAL
  ANNUAL
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  detail    String?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")
  userId    String   @map("user_id")
  organizationId String? @map("organization_id")

  user      User     @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@map("audit_logs")
}

model ClientPortalToken {
  id             String    @id @default(cuid())
  token          String    @unique
  clientId       String    @map("client_id")
  userId         String    @map("user_id")
  organizationId String?   @map("organization_id")
  label          String?
  expiresAt      DateTime? @map("expires_at")
  isActive       Boolean   @default(true) @map("is_active")
  lastAccessedAt DateTime? @map("last_accessed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  client       Client        @relation(fields: [clientId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@map("client_portal_tokens")
}

model AccountMaster {
  id             String      @id @default(cuid())
  code           String
  name           String
  type           AccountType
  isActive       Boolean     @default(true) @map("is_active")
  sortOrder      Int         @default(0) @map("sort_order")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  userId         String      @map("user_id")
  organizationId String?     @map("organization_id")

  user         User          @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@unique([code, userId], name: "account_code_user")
  @@unique([code, organizationId], name: "account_code_org")
  @@map("account_masters")
}

model KnowledgeFile {
  id             String   @id @default(cuid())
  name           String
  mimeType       String   @map("mime_type")
  extractedText  String   @map("extracted_text")
  fileSize       Int      @map("file_size")
  userId         String   @map("user_id")
  organizationId String?  @map("organization_id")
  clientId       String?  @map("client_id")
  createdAt      DateTime @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  client       Client?       @relation(fields: [clientId], references: [id])

  @@map("knowledge_files")
}
